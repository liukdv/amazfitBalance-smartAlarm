[Unit]
Description=Watch log receiver (localhost; nginx publishes it at /wlog)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
Environment=WLOG_PORT=8096
Environment=WLOG_FILE=/var/log/wlog/watch.jsonl
# Generate a long random token (e.g. `openssl rand -base64 18 | tr -d /+=`)
# and use the SAME value in the URL inside probe/app-side/index.js.
Environment=WLOG_TOKEN=PUT-YOUR-TOKEN-HERE
WorkingDirectory=/opt/wlog
ExecStart=/usr/bin/python3 /opt/wlog/wlog.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
